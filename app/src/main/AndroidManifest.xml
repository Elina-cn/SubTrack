<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime request on API 33+ arrives in phase 10c; until then the reminder simply stays
         quiet when the permission is not granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SubTrackApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubTrack">
        <!-- adjustResize is not the phase 9b-2 workaround any more, it is the pre-API-30 half of
             the keyboard handling. Window#setDecorFitsSystemWindows(false) makes the platform
             ignore this flag from API 30 on, and from there WindowInsets.ime carries real values
             that Modifier.imePadding acts on. Below API 30 that inset is never reported and
             padding by it does nothing, so the window resizing is the only thing that keeps a
             save button reachable - measured on API 29, where removing this line put Save and
             Reset behind the keyboard with no way to scroll to them. The two never overlap:
             exactly one of them is in force on any given release. See ARCHITECTURE section 16. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SubTrack.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager has to be initialised on demand instead, because its worker needs the Hilt
             factory the Application supplies. Only that one entry is removed: the provider itself
             is shared with emoji2, lifecycle and profileinstaller, and dropping it would take
             their initialisers down too. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>