    <string name="statistics_trend">Monthly trend</string>
    <!-- One sentence that is true of both the no-month and the one-month state. -->
    <string name="statistics_trend_collecting">A trend needs at least two months. Each month\'s total is recorded as you go, and the chart appears once the second month is in.</string>
