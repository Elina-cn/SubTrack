    <string name="statistics_trend_point">%1$s %2$s</string>
    <!-- No row for that month - not to be confused with "0.00". -->
    <string name="statistics_trend_point_missing">%1$s no record</string>
    <string name="statistics_trend_separator">", "</string>
    <plurals name="statistics_trend_other_currency">
        <item quantity="one">%1$d month recorded in another currency is not shown</item>
        <item quantity="other">%1$d months recorded in another currency are not shown</item>
    </plurals>
    <!-- Change since last month: the direction is written in words, not carried by colour. -->
    <string name="statistics_change_up">%1$s more than last month</string>
    <string name="statistics_change_down">%1$s less than last month</string>
