<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and transfer rules for API 31 and above. The pre-31 half of this decision lives in
    backup_rules.xml; neither file substitutes for the other, because the platform reads only the
    one that matches the running release and minSdk is 24. See ARCHITECTURE section 17.

    Listing any <include> turns the rules into an allow-list: anything not named here stays out of
    the backup, so a file added later is excluded until someone decides otherwise.
-->
<data-extraction-rules>

    <!-- Backup to the user's own Google Drive. -->
    <cloud-backup>
        <!-- The whole database domain, not just subtrack.db. Room runs in WAL mode, so committed
             rows can still be sitting in subtrack.db-wal when the backup is taken; carrying the
             main file alone would silently drop them. -shm is a derived index SQLite rebuilds on
             its own, and it is harmless to carry along with the pair that matters. -->
        <include domain="database" path="." />
        <!-- DataStore preferences: main currency, exchange rates and the theme choice. -->
        <include domain="file" path="datastore" />
    </cloud-backup>

    <!-- Device-to-device transfer, when the user sets up a new phone from the old one. Same
         content: the two paths hold everything the user typed, and nothing else is worth moving. -->
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>

</data-extraction-rules>
