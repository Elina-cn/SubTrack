*.iml
.gradle
.kotlin
local.properties
# Everything under .idea/ is ignored and the shared project files are listed back in
# one by one. The old per-file list only named the machine-specific files known at the
# time, so any new IDE file - a device list, a deploy target, a local path - landed in
# the repo by default. This way the default is "out" and adding a file is deliberate.
# `/.idea/*` rather than `/.idea/`, because git cannot re-include a file whose parent
# directory is excluded.
/.idea/*
!/.idea/.gitignore
!/.idea/AndroidProjectSystem.xml
!/.idea/compiler.xml
!/.idea/gradle.xml
!/.idea/inspectionProfiles/
!/.idea/misc.xml
!/.idea/runConfigurations.xml
!/.idea/vcs.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
# Build outputs and signing material must never be committed
*.apk
*.aab
*.jks
*.keystore
*.p12
*.pfx
# Firebase/Google service configuration carries project ids and client keys
google-services.json
# Byte-code left behind by the icon generator under tools/
__pycache__/
*.pyc
